{
  "name": "dsh-mysql",
  "version": "0.4.1",
  "description": "DeepSeek Harness 数据库连接插件：在设置页配置多套 MySQL / PostgreSQL 连接（每连接可配表白名单、行写与结构变更权限），输入栏一键切换当前会话的数据源，为所有 Agent 预设全局提供 mysql_query / mysql_tables / mysql_execute / mysql_ddl 与 pg_query / pg_tables / pg_execute / pg_ddl 工具。Database connector for DeepSeek Harness: configure multiple MySQL and PostgreSQL connections in settings (per-connection table allowlist, row-write and schema-change permissions), switch the active data sources from the composer, and expose mysql_* / pg_* tools globally to every agent preset.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./typert": { "default": "./lib/typert.host.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/shared.js",
    "lib/session-selection.js",
    "lib/typert.host.js",
    "lib/client.js",
    "lib/dialects",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "screenshots.json",
    "assets",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mysql",
    "postgresql",
    "postgres",
    "database",
    "sql",
    "tools",
    "connector"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1321928757/dsh-mysql.git"
  },
  "dependencies": {
    "mysql2": "^3.11.0",
    "pg": "^8.23.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "react": { "optional": true }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0",
    "node": ">=20"
  }
}
